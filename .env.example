# PostgreSQL Credentials
POSTGRES_DB=prepora_db
POSTGRES_USER=prepora_user
POSTGRES_PASSWORD=prepora_secret_pass_123

# Django Database Connection
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=prepora_db
DB_USER=prepora_user
DB_PASSWORD=prepora_secret_pass_123

# Django Application Settings
SECRET_KEY=django-insecure-docker-compose-secret-key-1234567890
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
